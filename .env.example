# Copy to .env and fill in. See DEPLOY.md for where each value comes from.

# --- Database (Neon Postgres) ---
# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler"): used by prisma migrate deploy.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Email (Resend) ---
# Sign-in is passwordless: users get a magic link by email, sent via Resend — so in
# production RESEND_API_KEY is REQUIRED for login (and for reminder/notification mails).
# Leave it empty in local dev to log the link/emails to the server console instead.
RESEND_API_KEY=""
# The magic-link "from" address. onboarding@resend.dev only delivers to your own verified
# address — verify a domain in Resend and use an address on it to reach your friends.
EMAIL_FROM="Coworking Frens <onboarding@resend.dev>"
# Comma-separated recipients for feedback notifications. Feedback is always saved in DB.
FEEDBACK_TO_EMAIL=""
# Comma-separated emails allowed to view /admin/feedback. If empty, FEEDBACK_TO_EMAIL is used.
ADMIN_EMAILS=""

# --- Uploads (Vercel Blob) ---
# Required for direct browser image uploads. Create a Blob store in Vercel Storage,
# connect it to the project, then pull env vars locally with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# --- Google Maps ---
# Public browser key for the host address picker. Restrict it by HTTP referrer in
# Google Cloud and enable Maps JavaScript API + Places API (new).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- App ---
# Public base URL, used in invite links and emails. On Vercel it auto-detects
# the deployment domain if unset, but setting it to your real domain is best.
APP_URL="http://localhost:3000"
# Protects /api/cron. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=""
