# Copy to .env and fill in. See DEPLOY.md for where each value comes from.

# --- Database (Neon Postgres) ---
# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler"): used by prisma migrate deploy.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Google OAuth — console.cloud.google.com. Real sign-in needs these.
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Set to 1 to allow the passwordless dev login in a non-dev deploy (leave unset in prod).
# ALLOW_DEV_LOGIN=

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty to log emails to the server console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Coworking Frens <onboarding@resend.dev>"

# --- App ---
# Public base URL, used in invite links and emails. On Vercel it auto-detects
# the deployment domain if unset, but setting it to your real domain is best.
APP_URL="http://localhost:3000"
# Protects /api/cron. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=""
